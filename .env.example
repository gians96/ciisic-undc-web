NODE_ENV=development
# URL pública del backend (backend-ciisic): el navegador envía aquí DNI, verificación, inscripciones, papers y contacto
NUXT_PUBLIC_API_BASE_URL=http://localhost:3010
# Código del evento que muestra la landing (API pública multi-evento de backend-ciisic)
NUXT_PUBLIC_EVENTO_CODIGO=ciisic-viii-2026
# Panel administrativo (aplicación externa); /login redirige a esta URL
NUXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Dirección del backend alcanzable por Nitro (red interna) para las lecturas con caché de 60 s
# (evento y tipos de inscripción). No es un secreto; si se omite se usa NUXT_PUBLIC_API_BASE_URL.
NUXT_BACKEND_BASE_URL=http://localhost:3010
