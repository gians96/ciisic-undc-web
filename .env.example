# Solo dos variables, ambas de servidor y de runtime. El client ID de Google y la URL del panel no
# van aquí: se configuran en backend-ciisic y la landing los lee de GET /api/v1/site/config.

# Dirección de backend-ciisic alcanzable por el servidor Nitro (la landing llama a {URL}/api/v1/site)
NUXT_BACKEND_BASE_URL=http://localhost:3010
# Token de acceso del evento para la API del sitio. Secreto de servidor: se define en runtime,
# nunca en el build ni en variables NUXT_PUBLIC_*. Se genera en el panel de backend-ciisic.
NUXT_BACKEND_EVENT_TOKEN=
